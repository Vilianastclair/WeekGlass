# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM python@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app/runtime
COPY runtime/requirements-linux.lock /app/runtime/requirements-linux.lock
RUN --mount=type=bind,source=runtime/wheels,target=/wheels,readonly pip install --no-index --find-links=/wheels --require-hashes -r requirements-linux.lock && useradd --uid 10001 --no-create-home app
COPY contracts /app/contracts
COPY runtime/weekglass_server /app/runtime/weekglass_server
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "weekglass_server.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--limit-concurrency", "16", "--timeout-keep-alive", "5", "--no-access-log"]
