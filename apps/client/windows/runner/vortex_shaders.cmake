# Compile the four entry points with the Windows SDK selected by the generator.
# Generated bytecode is embedded; minimizing a window never compiles HLSL.
get_filename_component(WG_WINDOWS_KITS
  "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows Kits\\Installed Roots;KitsRoot10]"
  ABSOLUTE)
find_program(WG_FXC fxc.exe HINTS
  "${WG_WINDOWS_KITS}/bin/${CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION}/x64"
  "$ENV{WindowsSdkVerBinPath}/x64")
if(NOT WG_FXC)
  message(FATAL_ERROR "The Windows SDK shader compiler fxc.exe is required for WeekGlass.")
endif()
set(WG_SHADER_DIR "${CMAKE_CURRENT_BINARY_DIR}/vortex_shaders")
foreach(entry SheetVS SheetPS GlintVS GlintPS)
  if(entry MATCHES "VS$")
    set(profile vs_4_0)
  else()
    set(profile ps_4_0)
  endif()
  set(bytecode "${WG_SHADER_DIR}/${entry}.h")
  add_custom_command(OUTPUT "${bytecode}"
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${WG_SHADER_DIR}"
    COMMAND "${WG_FXC}" /nologo /Ges /O3 /E "${entry}" /T "${profile}"
            /Qstrip_reflect /Qstrip_debug /Fh "${bytecode}" /Vn "k${entry}"
            "${CMAKE_CURRENT_SOURCE_DIR}/vortex.hlsl"
    DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/vortex.hlsl"
    VERBATIM)
  target_sources(${BINARY_NAME} PRIVATE "${bytecode}")
endforeach()
target_include_directories(${BINARY_NAME} PRIVATE "${WG_SHADER_DIR}")
