// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = WeekGlass

// Native integration builds may set a suffix to get a separate sandbox container.
WEEKGLASS_MACOS_BUNDLE_SUFFIX =
PRODUCT_BUNDLE_IDENTIFIER = com.viliana.weekglass$(WEEKGLASS_MACOS_BUNDLE_SUFFIX)

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Viliana. All rights reserved.

// Pinned WeekGlass account-service certificate, not a system trust anchor.
WG_ACCOUNT_SIGNING_LEAF = 942A2793EB98F519A4D23E5626C96D2EED0FA03C
